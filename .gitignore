# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Never commit environment files or local state
.env
.env.*
!.env.example
.local/
*.sqlite
*.db

# Evaluation output that has not been reviewed for publishing
eval-runs/

# Terraform: never commit state, plans, provider caches or real variable values
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
