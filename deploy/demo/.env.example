# The demo bundle's settings on a server. Copy it to deploy/demo/.env (which is
# gitignored), fill in the first block, and run ./deploy/demo/demo.sh up.
# Without a .env, demo.sh runs locally on 127.0.0.1:3930 with the stand-in model.
# Every other secret (database, Redis, Chatwoot, the gateway's key, the bot's
# tokens) is generated by demo.sh into deploy/demo/.local/ on first run.

# --- Required on a server ------------------------------------------------------
# The page's host name. chat.<domain> and bot.<domain> must resolve to the
# same server: one A record for the name and one wildcard A record for *.<name>.
DEMO_DOMAIN=demo.example.com
# Let's Encrypt's contact address for the certificates.
DEMO_ACME_EMAIL=owner@example.com
# The owner's sign-in for the Chatwoot dashboard, where held drafts are approved.
# The password is generated into .local/people.env.
DEMO_ADMIN_EMAIL=owner@example.com

# --- The model -----------------------------------------------------------------
# stand-in (no key, not a model) or gemini. Switching is this line and the key.
DEMO_MODEL=gemini
GEMINI_API_KEY=
# The Gemini model the gateway calls.
DEMO_GEMINI_MODEL=gemini/gemini-3.5-flash-lite
# The most the gateway may spend on the model in one day, in US dollars. Once it
# is reached every message gets the shop's holding message until the day rolls over.
DEMO_DAILY_BUDGET_USD=1.00

# --- Optional, with their defaults ----------------------------------------------
# Messages a visitor may post per minute, per IP address, and the burst allowed.
# DEMO_RATE_MESSAGES_PER_MINUTE=6
# DEMO_RATE_MESSAGES_BURST=5
# New widget sessions (Chatwoot contacts) per hour, per IP address.
# DEMO_RATE_CONTACTS_PER_HOUR=30
# DEMO_RATE_CONTACTS_BURST=10
# Conversations untouched for this many days are deleted, checked this often.
# DEMO_RESET_DAYS=1
# DEMO_RESET_EVERY_SECONDS=3600
