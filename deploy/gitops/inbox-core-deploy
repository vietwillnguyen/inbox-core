#!/usr/bin/env bash
# The demo's pull-based deploy agent. A systemd timer runs it every few minutes:
#
#   inbox-core-deploy run          deploy the newest new release tag, if there is one
#   inbox-core-deploy deploy TAG   deploy TAG now (also a tag that failed before)
#   inbox-core-deploy redeploy     fetch the secrets again and bring the current tag up
#   inbox-core-deploy status       the last outcome, the current tag, the failed tags
#   inbox-core-deploy pause        stop deploying new tags until resume
#   inbox-core-deploy resume
#
# A deploy checks the tag out in the clone, writes the bundle's settings file
# (the host's settings plus the secrets), runs demo.sh up and then demo.sh smoke
# as the gate. If either fails, the tag is recorded as failed (never retried by
# run) and the previous tag is checked out and brought back up.
#
# It needs nothing inbound and no cloud credentials: it reads a public git
# remote, and the secrets come from a command the host's installer configures
# (on AWS, one that reads Parameter Store) or from a file. Nothing here knows
# which cloud, if any, it runs on.
#
# Configuration: /etc/inbox-core/deploy.conf (INBOX_CORE_DEPLOY_CONF overrides),
# a shell file of KEY=value lines; see deploy/gitops/deploy.conf.example.
# Every outcome goes to stdout (the journal under systemd), one line to
# $STATE_DIR/history.log, and the last one to $STATE_DIR/status.
set -euo pipefail

CONF=${INBOX_CORE_DEPLOY_CONF:-/etc/inbox-core/deploy.conf}
[ -f "$CONF" ] || { echo "inbox-core-deploy: no configuration at $CONF" >&2; exit 2; }
# shellcheck source=/dev/null
. "$CONF"

: "${CHECKOUT_DIR:?set CHECKOUT_DIR in $CONF}"
: "${TAG_PATTERN:?set TAG_PATTERN in $CONF}"
: "${SETTINGS_FILE:?set SETTINGS_FILE in $CONF}"
STATE_DIR=${STATE_DIR:-/var/lib/inbox-core-deploy}
ENV_FILE=${ENV_FILE:-/etc/inbox-core/demo.env}
REMOTE=${REMOTE:-origin}
INITIAL_TAG=${INITIAL_TAG:-}
SECRETS_COMMAND=${SECRETS_COMMAND:-}
SECRETS_FILE=${SECRETS_FILE:-}
SMOKE_ATTEMPTS=${SMOKE_ATTEMPTS:-3}
SMOKE_RETRY_SECONDS=${SMOKE_RETRY_SECONDS:-30}

log() { printf '%s inbox-core-deploy: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die() { log "error: $*"; exit 1; }

mkdir -p "$STATE_DIR"
CURRENT_FILE=$STATE_DIR/current
FAILED_FILE=$STATE_DIR/failed
touch "$FAILED_FILE"

current_tag() { if [ -s "$CURRENT_FILE" ]; then cat "$CURRENT_FILE"; fi; }
is_failed() { grep -qxF -- "$1" "$FAILED_FILE"; }

# One line of history and the status file: outcome, tag, previous tag, detail.
record() {
  local outcome=$1 tag=$2 previous=$3 detail=$4 now
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s outcome=%s tag=%s previous=%s detail=%s\n' \
    "$now" "$outcome" "${tag:--}" "${previous:--}" "$detail" >> "$STATE_DIR/history.log"
  cat > "$STATE_DIR/status.new" <<STATUS
time=${now}
outcome=${outcome}
tag=${tag}
previous=${previous}
current=$(current_tag)
detail=${detail}
STATUS
  mv "$STATE_DIR/status.new" "$STATE_DIR/status"
  log "outcome=${outcome} tag=${tag:--} previous=${previous:--} ${detail}"
}

git_c() { git -C "$CHECKOUT_DIR" "$@"; }

fetch_tags() {
  git_c fetch --quiet --force --prune --prune-tags --tags "$REMOTE"
}

# Tags matching the pattern, newest first by version order.
release_tags() { git_c tag --list "$TAG_PATTERN" --sort=-version:refname; }

# True when $1 sorts after $2 in version order.
newer_than() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]; }

# The tag run should deploy, or nothing: the newest tag that is newer than the
# current one and has not failed. With no current tag, INITIAL_TAG (if set)
# or the newest tag.
next_tag() {
  local current tag
  current=$(current_tag)
  if [ -z "$current" ] && [ -n "$INITIAL_TAG" ]; then
    is_failed "$INITIAL_TAG" || echo "$INITIAL_TAG"
    return 0
  fi
  while IFS= read -r tag; do
    [ -n "$tag" ] || continue
    if [ -n "$current" ] && ! newer_than "$tag" "$current"; then return 0; fi
    is_failed "$tag" && continue
    echo "$tag"
    return 0
  done < <(release_tags)
}

settings_and_secrets() {
  cat "$SETTINGS_FILE"
  echo
  if [ -n "$SECRETS_COMMAND" ]; then
    # Split on purpose: the command may carry its own arguments.
    # shellcheck disable=SC2086
    $SECRETS_COMMAND
  elif [ -n "$SECRETS_FILE" ]; then
    cat "$SECRETS_FILE"
  fi
}

# The bundle's settings file: the host's settings, then the secrets. Written
# mode 600 and swapped in whole, so a failed fetch never leaves half a file.
write_env() {
  [ -f "$SETTINGS_FILE" ] || die "no settings file at $SETTINGS_FILE"
  local tmp
  tmp=$(mktemp "${ENV_FILE}.XXXXXX")
  chmod 600 "$tmp"
  if ! settings_and_secrets > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$ENV_FILE"
}

demo() { (cd "$CHECKOUT_DIR" && DEMO_ENV_FILE="$ENV_FILE" ./deploy/demo/demo.sh "$@"); }

smoke() {
  local attempt
  for attempt in $(seq "$SMOKE_ATTEMPTS"); do
    if demo smoke; then return 0; fi
    log "smoke test failed (attempt ${attempt} of ${SMOKE_ATTEMPTS})"
    [ "$attempt" -lt "$SMOKE_ATTEMPTS" ] && sleep "$SMOKE_RETRY_SECONDS"
  done
  return 1
}

# Check out and bring up one tag, gated on the smoke test.
bring_up() {
  local tag=$1
  log "checking out ${tag}"
  git_c -c advice.detachedHead=false checkout --quiet --force --detach "refs/tags/${tag}" || return 1
  log "bringing ${tag} up"
  demo up || { log "demo.sh up failed for ${tag}"; return 1; }
  log "smoke testing ${tag}"
  smoke || { log "smoke test failed for ${tag}"; return 1; }
}

deploy() {
  local tag=$1 previous
  previous=$(current_tag)
  git_c rev-parse --quiet --verify "refs/tags/${tag}" >/dev/null || die "no tag ${tag} in ${CHECKOUT_DIR}"
  if ! write_env; then
    record failed "$tag" "$previous" "the secrets could not be fetched; nothing was changed"
    return 1
  fi
  if bring_up "$tag"; then
    echo "$tag" > "$CURRENT_FILE"
    grep -vxF -- "$tag" "$FAILED_FILE" > "$FAILED_FILE.new" || true
    mv "$FAILED_FILE.new" "$FAILED_FILE"
    record deployed "$tag" "$previous" "up and smoke test passed"
    return 0
  fi
  is_failed "$tag" || echo "$tag" >> "$FAILED_FILE"
  if [ -z "$previous" ] || [ "$previous" = "$tag" ]; then
    record failed "$tag" "$previous" "no previous tag to return to"
    return 1
  fi
  log "returning to ${previous}"
  if bring_up "$previous"; then
    record rolled-back "$tag" "$previous" "${tag} failed; ${previous} is back up and passed the smoke test"
  else
    record rollback-failed "$tag" "$previous" "${tag} failed, and ${previous} did not pass the smoke test either"
  fi
  return 1
}

main() {
  local command=${1:-run}
  case "$command" in
    run)
      if [ -e "$STATE_DIR/paused" ]; then log "paused; nothing to do"; return 0; fi
      fetch_tags || die "could not fetch tags from ${REMOTE}"
      local tag
      tag=$(next_tag)
      if [ -z "$tag" ]; then
        log "no new tag matching ${TAG_PATTERN} (current: $(current_tag || true))"
        return 0
      fi
      deploy "$tag"
      ;;
    deploy)
      [ -n "${2:-}" ] || die "usage: inbox-core-deploy deploy TAG"
      fetch_tags || die "could not fetch tags from ${REMOTE}"
      deploy "$2"
      ;;
    redeploy)
      local tag
      tag=$(current_tag)
      [ -n "$tag" ] || die "nothing is deployed yet"
      deploy "$tag"
      ;;
    status)
      if [ -f "$STATE_DIR/status" ]; then cat "$STATE_DIR/status"; else echo "no deploy yet"; fi
      [ -e "$STATE_DIR/paused" ] && echo "paused=yes"
      [ -s "$FAILED_FILE" ] && echo "failed_tags=$(paste -sd ' ' "$FAILED_FILE")"
      return 0
      ;;
    pause) touch "$STATE_DIR/paused"; log "paused: new tags are not deployed until resume" ;;
    resume) rm -f "$STATE_DIR/paused"; log "resumed" ;;
    *) sed -n '2,24p' "$0"; return 2 ;;
  esac
}

# One deploy at a time, whether from the timer or a person. Reading the
# status needs no lock.
if [ "${1:-run}" != status ]; then
  exec 9>"$STATE_DIR/lock"
  if ! flock -n 9; then log "another deploy is running; skipping"; exit 0; fi
fi
main "$@"
